---
import { useTranslations } from "@i18n/utils";
interface Props {
  user: string;
  domain: string;
  lang?: "en" | "fr";
}
const { user, domain, lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<button
  data-user={user}
  data-domain={domain}
  onclick="var d=this.dataset,e=d.user+'@'+d.domain,a=document.createElement('a');a.href='mailto:'+e;a.textContent=e;a.className='text-primary-600 hover:underline ml-1';this.replaceWith(a);"
  class="min-h-0 ml-1"
>
  {t("show-email-label")}
</button>
